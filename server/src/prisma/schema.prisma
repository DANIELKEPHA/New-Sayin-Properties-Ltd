generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum PropertyType {
  Apartment
  Condo
  Townhouse
  Villa
  Cottage
  Bungalow
  Mansion
  Duplex
  TinyHouse
  Room
  ServicedApartment
  Penthouse
  Office
  Retail
  Warehouse
  Industrial
  Hotel
  Restaurant
  Farmhouse
  ResidentialLand
  CommercialLand
  AgriculturalLand
  MixedUseLand
  Land
}

enum Highlight {
  HighSpeedInternetAccess
  WasherDryer
  AirConditioning
  Heating
  SmokeFree
  CableReady
  SatelliteTV
  DoubleVanities
  TubShower
  Intercom
  SprinklerSystem
  RecentlyRenovated
  CloseToTransit
  GreatView
  QuietNeighborhood
}

enum Amenity {
  WasherDryer
  AirConditioning
  Dishwasher
  HighSpeedInternet
  HardwoodFloors
  WalkInClosets
  Microwave
  Refrigerator
  Pool
  Gym
  Parking
  PetsAllowed
  WiFi
  Security
  Balcony
  Garden
}

enum Infrastructure {
  Water
  Electricity
  RoadAccess
  Sewerage
  Internet
  StreetLighting
  Fence
}

enum ApplicationStatus {
  Pending
  Denied
  Approved
}

enum PaymentStatus {
  Pending
  Paid
  PartiallyPaid
  Overdue
}

enum PaymentPlan {
  FULL_PAYMENT
  INSTALLMENTS
  FLEXIBLE
}

enum PriceUnit {
  PER_MONTH
  PER_YEAR
  PER_SQM
  PER_ACRE
  TOTAL
}

enum SizeUnit {
  SQM
  ACRES
  HECTARES
}

enum ListingStatus {
  AVAILABLE
  SOLD
  RENTED
  PENDING
}

model Property {
  id                Int              @id @default(autoincrement())
  title             String           @default("Untitled Property")
  description       String
  category          PropertyCategory @default(RESIDENTIAL)
  propertyType      PropertyType?
  price             Float            @default(0)
  priceUnit         PriceUnit        @default(PER_MONTH)
  paymentPlan       PaymentPlan?
  size              Float?
  sizeUnit          SizeUnit?
  pricePerMonth     Float?
  securityDeposit   Float?
  applicationFee    Float?
  beds              Int?
  baths             Float?
  squareFeet        Int?
  highlights        Highlight[]
  infrastructure    Infrastructure[]
  isForSale         Boolean          @default(false)
  isForRent         Boolean          @default(true)
  isPetsAllowed     Boolean          @default(false)
  isParkingIncluded Boolean          @default(false)
  photoUrls         String[]         @default([])
  listedAt          DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  averageRating     Float?           @default(0)
  numberOfReviews   Int?             @default(0)
  status            ListingStatus    @default(AVAILABLE)
  locationId        Int
  managerCognitoId  String
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  manager           Manager          @relation(fields: [managerCognitoId], references: [cognitoId], onDelete: Cascade)
  leases            Lease[]
  applications      Application[]
  favoritedBy       Tenant[]         @relation("TenantFavorites")
  tenants           Tenant[]         @relation("TenantProperties")
}

model Manager {
  id          Int    @id @default(autoincrement())
  cognitoId   String @unique
  name        String
  email       String
  phoneNumber String

  managedProperties Property[]
}

model Tenant {
  id          Int     @id @default(autoincrement())
  cognitoId   String  @unique
  name        String
  email       String
  phoneNumber String?

  properties   Property[]    @relation("TenantProperties")
  favorites    Property[]    @relation("TenantFavorites")
  applications Application[]
  leases       Lease[]
  contacts     Contact[]     @relation("TenantContacts")
}

model Location {
  id          Int                                   @id @default(autoincrement())
  address     String
  city        String
  state       String
  country     String
  postalCode  String
  coordinates Unsupported("geography(Point, 4326)")

  properties Property[]
}

model Application {
  id              Int               @id @default(autoincrement())
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(Pending)
  propertyId      Int
  tenantCognitoId String
  name            String
  email           String
  phoneNumber     String
  message         String?
  leaseId         Int?              @unique

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantCognitoId], references: [cognitoId])
  lease    Lease?   @relation(fields: [leaseId], references: [id])
}

model Lease {
  id              Int      @id @default(autoincrement())
  startDate       DateTime
  endDate         DateTime
  rent            Float
  deposit         Float
  propertyId      Int
  tenantCognitoId String

  property    Property     @relation(fields: [propertyId], references: [id])
  tenant      Tenant       @relation(fields: [tenantCognitoId], references: [cognitoId])
  application Application?
  payments    Payment[]
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountDue     Float
  amountPaid    Float
  dueDate       DateTime
  paymentDate   DateTime
  paymentStatus PaymentStatus
  leaseId       Int

  lease Lease @relation(fields: [leaseId], references: [id])
}

model Contact {
  id              Int      @id @default(autoincrement())
  name            String
  email           String
  message         String?
  interests       String?
  privacyConsent  Boolean
  tenantCognitoId String?
  createdAt       DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantCognitoId], references: [cognitoId], onDelete: SetNull, name: "TenantContacts")

  @@index([tenantCognitoId])
}
